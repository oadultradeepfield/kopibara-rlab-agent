{
  "name": "kopibara-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src tests *.json *.ts *.js *.html README.md && eslint .",
    "format": "prettier --write src tests *.json *.ts *.js *.html README.md && eslint --fix .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "plotly.js-dist-min": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plotly.js": "^4.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/plotly.js": "^3.0.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
